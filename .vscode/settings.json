{
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    },
    "editor.rulers": [
      120
    ]
  },
  "dart.lineLength": 120,
  "dart.runPubGetOnPubspecChanges": "always",
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.dart_tool": true
  },
  "search.exclude": {
    "**/*.g.dart": true,
    "**/*.freezed.dart": true
  }
}